{
  "compilerOptions": {
    "target": "ES2023", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "strict": true,
    "noEmit": true, "allowImportingTsExtensions": true,
    "types": ["@cloudflare/workers-types", "node"],
    "skipLibCheck": true, "verbatimModuleSyntax": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "scripts/**/*.ts", "vite.config.ts", "playwright.config.ts"]
}
