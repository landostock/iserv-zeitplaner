{
  "name": "iserv-zeitplaner-personal",
  "version": "1.0.0-rc2",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "build": "node scripts/verify-release.mjs && vite build",
    "deploy": "wrangler deploy",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "test": "tsx --test test/*.test.ts",
    "test:browser": "playwright test"
  },
  "dependencies": {
    "@block65/webcrypto-web-push": "2.0.0",
    "@simplewebauthn/browser": "14.0.0",
    "@simplewebauthn/server": "14.1.0",
    "fast-xml-parser": "5.12.0",
    "jose": "6.2.13"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261028.1",
    "@levischuck/tiny-cbor": "0.2.11",
    "@playwright/test": "1.64.1",
    "@types/node": "26.6.6",
    "esbuild": "0.28.2",
    "miniflare": "5.20261023.1-beta",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "wrangler": "4.154.0"
  },
  "cloudflare": {
    "bindings": {
      "SETUP_CODE": {
        "description": "Zufälligen Code mit mindestens 24 Zeichen im Passwortmanager erzeugen und speichern. Hier als Secret eintragen. Sie brauchen ihn anschließend auf Ihrer neuen Website."
      }
    }
  }
}
